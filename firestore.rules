rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public visitors can read the shared route network map;
    // ONLY authenticated editor accounts can create or update the network state.
    match /networkState/default {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
                   && request.resource.data.payload.airports is list
                   && request.resource.data.payload.routes is list
                   && request.resource.data.payload.airports.size() <= 500
                   && request.resource.data.payload.routes.size() <= 2000;
    }

    // Deny access to all other collections/documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
