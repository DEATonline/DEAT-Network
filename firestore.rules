rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone visiting the map can read the live network;
    // Only authenticated editor accounts can publish updates.
    match /networkState/default {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
                   && request.resource.data.payload.airports is list
                   && request.resource.data.payload.routes is list
                   && request.resource.data.payload.airports.size() <= 500
                   && request.resource.data.payload.routes.size() <= 2000;
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
